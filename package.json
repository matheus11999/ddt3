{
  "name": "brasa-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test --import ./tests/fixtures/weapons.ts --import ./tests/fixtures/maps.ts tests/*.test.ts",
    "test:integration": "tsx tests/integration.ts",
    "test:restart:integration": "tsx tests/restart.integration.ts",
    "test:worldboss:integration": "tsx tests/worldBoss.integration.ts",
    "test:load": "tsx tests/load.ts",
    "check": "tsc --noEmit",
    "test:maps:integration": "tsx tests/maps.integration.ts",
    "test:maps:browser": "node scripts/smoke-maps.mjs",
    "test:outfits": "node scripts/verify-outfits.mjs",
    "test:battle:browser": "node scripts/smoke-battle-controls.mjs",
    "test:walk:browser": "node scripts/smoke-walk.mjs",
    "test:rooms:integration": "tsx tests/rooms.integration.ts",
    "test:rooms:browser": "node scripts/smoke-rooms.mjs",
    "test:economy:integration": "tsx tests/economy.integration.ts",
    "test:rewards:browser": "node scripts/smoke-rewards.mjs",
    "test:shop:browser": "node scripts/smoke-shop.mjs",
    "test:power:integration": "tsx tests/power.integration.ts",
    "verify:cosmetics": "node scripts/verify-cosmetics.mjs",
    "build:map": "node scripts/build-map.mjs",
    "build:lobby": "node scripts/build-lobby.mjs",
    "admin:password": "tsx scripts/admin-password.ts",
    "test:admin:browser": "node scripts/smoke-admin.mjs",
    "verify:weapons": "node scripts/verify-weapons.mjs",
    "split:weapon-sheet": "node scripts/split-weapon-sheet.mjs",
    "cut:monster-sheet": "node scripts/cut-monster-sheet.mjs",
    "sounds:weapons": "node scripts/generate-weapon-sounds.mjs",
    "test:matchmaking:integration": "tsx tests/matchmaking.integration.ts",
    "test:gender:integration": "tsx tests/gender.integration.ts",
    "test:customization:browser": "node scripts/smoke-customization.mjs",
    "test:costumes": "node scripts/verify-costumes.mjs",
    "test:mobile:browser": "node scripts/smoke-mobile-landscape.mjs",
    "test:abilities:integration": "tsx tests/abilities.integration.ts",
    "test:loadout:integration": "tsx tests/ability-loadout.integration.ts",
    "test:loadout:browser": "node scripts/smoke-loadout.mjs",
    "test:immediate:browser": "node scripts/smoke-immediate-equipment.mjs",
    "test:colors:browser": "node scripts/smoke-colors.mjs",
    "test:reports:browser": "node scripts/smoke-reports.mjs",
    "test:expedition:browser": "node scripts/smoke-expedition.mjs",
    "test:mail:integration": "tsx tests/mail.integration.ts",
    "test:mail:browser": "node scripts/smoke-mail.mjs",
    "test:chat:browser": "node scripts/smoke-chat.mjs && node scripts/smoke-chat-bubbles.mjs",
    "test:auction:integration": "tsx tests/auction.integration.ts",
    "test:guilds:integration": "tsx tests/guilds.integration.ts",
    "test:pets:integration": "tsx tests/pets.integration.ts",
    "test:hall:integration": "tsx tests/hall.integration.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "tsx": "^4.20.6",
    "@playwright/test": "^1.56.0"
  }
}
